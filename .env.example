# MariaDB connection settings for the ticket backend
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ticket_db

# Server port (default 8080)
PORT=8080

# Directory where uploaded files are stored
UPLOADS_DIR=uploads

# Send the session cookie with the Secure flag (set true behind HTTPS)
COOKIE_SECURE=false

# Comma-separated list of extra allowed origins (beyond localhost)
CORS_ORIGINS=

# Base URL used in password-reset links sent by email
FRONTEND_URL=http://localhost:5173

# SMTP settings for password-reset emails (leave SMTP_HOST empty to log emails to console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=